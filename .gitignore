# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.uv_cache/

# Editor / OS
.vscode/
.DS_Store

# Research artifacts — regenerated by the pipeline, large, not versioned.
# Scoped to where they actually land (repo root + data/).
/AllCandidateLABvals_*.txt
/CandidateLABvals_MATLAB_*.txt
/CorrespondingRGBVals_MATLAB_*.txt
/data/*.binvox
/data/MATLAB_*.txt

# Smoke-test scratch output
/tests/_smoke_out/



# MATLAB pipeline intermediates (live under external/matlab_rgd/)
/external/matlab_rgd/*.off
/external/matlab_rgd/max_indices_*.txt
/external/matlab_rgd/u_D1.csv

# Stein 2020 curved-hessian repo is kept as a reference only and cloned on
# demand (see TODO.md). Too big to track (42 MB of C++ + CMake); equivalent
# algorithm is exposed via `libigl` Python bindings already in the env.
/external/stein2020_curved_hessian/

# Large regenerable outputs
/results/bench_lut_io/
/results/e2e_demo/_*.png
/results/e2e_demo/pv_test.png
/validation/e2e/out/
/validation/e2e/out_neural/
/validation/e2e/*_max_indices*.csv

# Paper pipeline regenerables
# Content-addressable LUT cache (each .npy is ~200 MB; rebuild via reproduce_all)
/data/luts/
# Per-panel intermediate renders used when compositing multi-panel figures
/results/paper/figures/_tmp_*/

# Scene videos — all regenerable (originals in external/unity/Assets/ or via
# yt-dlp for dubai_marina_timelapse; clean dusk/daytime extracts via
# scripts/paper/_extract_dubai_clips.py). Keep manifests + masks, skip mp4s.
/data/scenes/*/video.mp4
/results/shortpaper/figures/_tmp_*/

# Animation mp4/gif outputs (regenerable from scripts/paper/animate_*.py;
# 0.3-1 MB each but regenerated on every render and not part of paper.tex)
/results/shortpaper/figures/sphere_animation/
/results/shortpaper/figures/alpha_hull_animation/
/results/shortpaper/figures/gaussian_hull_animation/
/results/shortpaper/figures/neural_bias_animation/

# Validation artifacts: large dense LUTs + RGD checkpoints. The .md report
# is committed; the binary outputs are regenerable via scripts/paper/
# bake_neural_rgd_new.py (~80 min on 19 cores).
/results/shortpaper/validation/*.npy
/results/shortpaper/validation/*.npz
