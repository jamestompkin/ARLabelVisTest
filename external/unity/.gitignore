# Unity-specific ignores (scoped to this subtree).
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures / Recordings can be large
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store Tools / Jetbrains Rider plugin (optional, uncomment if needed)
# /[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Gradle caches
.vs/
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta / crash files
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Auto-generated Android StreamingAssets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Large LUT asset blobs that are regenerated by the research pipeline and
# imported into Assets/ by hand for the AR build.
/[Aa]ssets/**/*.asset
/[Aa]ssets/**/*.txt
/[Aa]ssets/**/*.csv
/[Aa]ssets/**/*.off

# Restored externals (symlinked or copied back from ../external/ for local Unity builds).
# Keep these untracked so the canonical copy is external/.
/Assets/Fantasy Forest Environment Free Sample/
/Assets/Fantasy Forest Environment Free Sample.meta
